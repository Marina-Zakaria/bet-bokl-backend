# Docker Hub image (build locally with ./push-image.sh — do not build on EC2)
APP_IMAGE=essamfakher5/bet-bokl-backend:staging

POSTGRES_DB=home_rental_db
POSTGRES_USER=bokl_app
POSTGRES_PASSWORD=replace-with-a-long-random-password

JWT_SECRET=replace-with-openssl-rand-base64-32-output
# Optional for first deploy — leave empty and the app generates keys itself
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

CORS_ALLOWED_ORIGIN_PATTERNS=https://your-frontend-domain.example
BOOKING_APPROVAL_EXPIRATION_CRON=0 5 0 * * *
TZ=Africa/Cairo
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50.0 -Xms128m
