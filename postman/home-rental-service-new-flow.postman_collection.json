            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/reject"
          }
        },
        {
          "name": "POST /api/bookings/{id}/pay",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{guestToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/pay"
          }
        },
        {
          "name": "POST /api/bookings/{id}/check-in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{guestToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/check-in"
          }
        },
        {
          "name": "POST /api/bookings/{id}/check-out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{guestToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/check-out"
          }
        },
        {
          "name": "POST /api/bookings/{id}/cancel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{guestToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/cancel"
          }
        },
        {
          "name": "POST /api/bookings/{id}/reviews/unit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{guestToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Great stay\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/reviews/unit"
          }
        },
        {
          "name": "POST /api/bookings/{id}/reviews/renter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 5,\n  \"comment\": \"Respectful guest\"\n}"
            },
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}/reviews/renter"
          }
        },
        {
          "name": "GET /api/renters/{renterId}/reviews",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/renters/{{renterId}}/reviews",
            "description": "Returns the renter name, average rating, review count, and owner reviews. Authentication required."
          }
        }
      ]
    }
  ]
}
