            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"2.0\",\n  \"titleEn\": \"Owner Terms v2\",\n  \"titleAr\": \"شروط المالك v2\",\n  \"contentEn\": \"Updated English terms\",\n  \"contentAr\": \"شروط عربية محدثة\",\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/api/terms"
          }
        },
        {
          "name": "PUT /api/terms/{id} (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
