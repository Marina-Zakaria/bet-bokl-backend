            "url": "{{baseUrl}}/api/bookings/as-owner?page=0&size=12"
          }
        },
        {
          "name": "GET /api/bookings/{id}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{guestToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/{{bookingId}}"
          }
        },
