            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": \"1.0\",\n  \"titleEn\": \"Owner Listing Terms\",\n  \"titleAr\": \"شروط إدراج الوحدة\",\n  \"contentEn\": \"…\",\n  \"contentAr\": \"…\",\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/api/terms/{{termsId}}"
          }
        }
      ]
    },
    {
      "name": "4. Units — public browse",
      "item": [
        {
          "name": "GET /api/units/categories — localized configured ranges",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/units/categories",
            "description": "Returns ECONOMY, PREMIUM, and HOTEL labels in Arabic/English with current DB-configured nightly-price boundaries."
          }
        },
        {
          "name": "GET /api/units/most-rented",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/units/most-rented?page=0&size=12"
          }
        },
        {
          "name": "GET /api/units/search (text + filters + dates + guests)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/units/search?q=Maadi&category=ECONOMY&minRent=100&maxRent=1000&hasElevator=true&hasWashingMachine=true&arrivalDate=2026-09-01&leaveDate=2026-09-05&adultsCount=2&childrenCount=1&sort=PRICE_ASC&page=0&size=12"
          }
        },
        {
          "name": "GET /api/units/search (text only)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/units/search?q=Road%209&sort=MOST_RENTED&page=0&size=12"
          }
        },
        {
          "name": "GET /api/units/search (filters only, no q)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/units/search?category=TOURIST&verified=true&hasPool=true&sort=RATING&page=0&size=12"
          }
        },
        {
          "name": "GET /api/units/{id}",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/units/{{unitId}}"
          }
        },
        {
          "name": "GET /api/units/{id}/reviews",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/units/{{unitId}}/reviews"
          }
        },
        {
          "name": "GET /api/units/{id}/availability",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/units/{{unitId}}/availability?from=2026-08-01&to=2026-10-01"
          }
        }
      ]
    },
    {
      "name": "5. Units — owner (auth)",
      "item": [
        {
          "name": "POST /api/units",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cozy Maadi Flat\",\n  \"description\": \"Nice unit\",\n  \"governorateId\": {{governorateId}},\n  \"areaId\": {{areaId}},\n  \"streetName\": \"Road 9\",\n  \"buildingNumber\": \"12\",\n  \"apartmentNumber\": \"4B\",\n  \"landmark\": \"Near metro\",\n  \"latitude\": 29.96,\n  \"longitude\": 31.27,\n  \"roomsCount\": 2,\n  \"bathroomsCount\": 1,\n  \"areaSqm\": 90,\n  \"furnishing\": \"FURNISHED\",\n  \"rentPerDay\": 450.0,\n  \"maxAdults\": 4,\n  \"maxChildren\": 2,\n  \"hasElevator\": true,\n  \"hasWashingMachine\": true,\n  \"hasWifi\": true,\n  \"hasAirConditioning\": true,\n  \"hasParking\": false,\n  \"hasPool\": false,\n  \"hasTv\": true,\n  \"hasKitchen\": true,\n  \"hasBalcony\": true,\n  \"hasWaterHeater\": true,\n  \"photos\": [\n    \"https://cdn.example.com/1.jpg\"\n  ],\n  \"idDocumentType\": \"NATIONAL_ID\",\n  \"idFrontUrl\": \"https://cdn.example.com/id-front.jpg\",\n  \"idBackUrl\": \"https://cdn.example.com/id-back.jpg\",\n  \"termsDefinitionId\": {{termsId}},\n  \"acceptTerms\": true,\n  \"requiresOwnerApproval\": true\n}"
            },
            "url": "{{baseUrl}}/api/units"
          }
        },
        {
          "name": "POST /api/units — instant booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Instant Booking Unit\",\n  \"description\": \"Nice unit\",\n  \"governorateId\": {{governorateId}},\n  \"areaId\": {{areaId}},\n  \"streetName\": \"Road 9\",\n  \"buildingNumber\": \"12\",\n  \"apartmentNumber\": \"4B\",\n  \"landmark\": \"Near metro\",\n  \"latitude\": 29.96,\n  \"longitude\": 31.27,\n  \"roomsCount\": 2,\n  \"bathroomsCount\": 1,\n  \"areaSqm\": 90,\n  \"furnishing\": \"FURNISHED\",\n  \"rentPerDay\": 450.0,\n  \"maxAdults\": 4,\n  \"maxChildren\": 2,\n  \"hasElevator\": true,\n  \"hasWashingMachine\": true,\n  \"hasWifi\": true,\n  \"hasAirConditioning\": true,\n  \"hasParking\": false,\n  \"hasPool\": false,\n  \"hasTv\": true,\n  \"hasKitchen\": true,\n  \"hasBalcony\": true,\n  \"hasWaterHeater\": true,\n  \"photos\": [\n    \"https://cdn.example.com/1.jpg\"\n  ],\n  \"idDocumentType\": \"NATIONAL_ID\",\n  \"idFrontUrl\": \"https://cdn.example.com/id-front.jpg\",\n  \"idBackUrl\": \"https://cdn.example.com/id-back.jpg\",\n  \"termsDefinitionId\": {{termsId}},\n  \"acceptTerms\": true,\n  \"requiresOwnerApproval\": false,\n  \"instantBookingTermsId\": {{instantBookingTermsId}},\n  \"acceptInstantBookingTerms\": true\n}"
            },
            "url": "{{baseUrl}}/api/units"
          }
        },
        {
          "name": "GET /api/units/mine",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/units/mine?page=0&size=12"
          }
        },
        {
          "name": "POST /api/units/{id}/unavailability",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2026-09-01\",\n  \"endDate\": \"2026-09-05\",\n  \"reason\": \"Personal use\"\n}"
            },
            "url": "{{baseUrl}}/api/units/{{unitId}}/unavailability"
          }
        },
        {
          "name": "DELETE /api/units/{id}/unavailability/{blockId}",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/units/{{unitId}}/unavailability/{{blockId}}"
          }
        }
      ]
    },
    {
      "name": "6. Bookings (auth)",
      "item": [
        {
          "name": "POST /api/bookings",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{guestToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unitId\": {{unitId}},\n  \"checkInDate\": \"2026-09-10\",\n  \"checkOutDate\": \"2026-09-13\",\n  \"adultsCount\": 2,\n  \"childrenCount\": 1\n}"
            },
            "url": "{{baseUrl}}/api/bookings"
          }
        },
        {
          "name": "GET /api/bookings/mine",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{guestToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/bookings/mine?page=0&size=12"
          }
        },
        {
          "name": "GET /api/bookings/as-owner",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ownerToken}}"
              }
