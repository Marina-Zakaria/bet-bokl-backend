{
  "info": {
    "name": "Bokl Marketplace — Contract APIs",
    "description": "Aligned with WEBSITE_BACKEND_API_CONTRACT.md. Nested RentalUnit/Booking shapes, Spring Page lists, CORS-ready.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "ownerToken",
      "value": ""
    },
    {
      "key": "guestToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "unitId",
      "value": "1"
    },
    {
      "key": "bookingId",
      "value": "1"
    },
    {
      "key": "blockId",
      "value": "1"
    },
    {
      "key": "termsId",
      "value": "1"
    },
    {
      "key": "governorateId",
      "value": "2"
    },
    {
      "key": "areaId",
      "value": "1"
    },
    {
      "key": "phone",
      "value": "+201012345678"
    },
    {
      "key": "password",
      "value": "Test@123456"
    },
    {
      "key": "otp",
      "value": "111111"
    },
    {
      "key": "registrationToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "instantBookingTermsId",
      "value": "1001"
    },
    {
      "key": "renterId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "GET /auth/public-key",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/public-key"
          }
        },
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ahmed Mohamed\",\n  \"phone\": \"{{phone}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "POST /auth/verify-otp",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{phone}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-otp"
          }
        },
        {
          "name": "POST /auth/complete-registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationToken\": \"{{registrationToken}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/complete-registration"
          }
        },
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrPhone\": \"{{phone}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "POST /auth/refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "POST /auth/forgot-password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{phone}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/forgot-password"
          }
        },
        {
          "name": "POST /auth/reset-password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{phone}}\",\n  \"otp\": \"{{otp}}\",\n  \"newPassword\": \"NewPass@123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/reset-password"
          }
        },
        {
          "name": "POST /auth/login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrPhone\": \"+201000000001\",\n  \"password\": \"Admin@123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "2. Locations (public)",
      "item": [
        {
          "name": "GET /locations/governorates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept-Language",
                "value": "en"
              }
            ],
            "url": "{{baseUrl}}/locations/governorates"
          }
        },
        {
          "name": "GET /locations/governorates/search?q=",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/locations/governorates/search?q=Cairo"
          }
        },
        {
          "name": "GET /locations/governorates/{id}/areas",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/locations/governorates/{{governorateId}}/areas"
          }
        },
        {
          "name": "GET /locations/areas/search?q=",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/locations/areas/search?q=Maadi"
          }
        }
      ]
    },
    {
      "name": "3. Terms",
      "item": [
        {
          "name": "GET /api/terms (active)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/terms"
          }
        },
        {
          "name": "GET /api/terms/{id}",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/terms/{{termsId}}"
          }
        },
        {
          "name": "GET /api/terms/all (admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/terms/all"
          }
        },
        {
          "name": "POST /api/terms (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
