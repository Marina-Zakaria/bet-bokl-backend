    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"phone\": \"+201234567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Screen 1/3: creates an unverified account and sends an OTP to the phone. No password or username at this stage. If the phone was already registered but not verified, a new OTP is reissued."
          },
          "response": []
        },
        {
          "name": "Verify Otp",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var body = pm.response.json();",
                  "    if (body.registrationToken) {",
                  "        pm.collectionVariables.set('registrationToken', body.registrationToken);",
                  "        console.log('[Auth] registrationToken saved.');",
                  "    }",
                  "    pm.test('registrationToken present', function() {",
                  "        pm.expect(body.registrationToken).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"+201234567890\",\n  \"otp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "description": "Screen 2/3: validates the OTP (auto-encrypted by the pre-request script). Returns a short-lived `registrationToken` (30 min) saved automatically to the collection variable."
          },
          "response": []
        },
        {
          "name": "Complete Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var body = pm.response.json();",
                  "    if (body.accessToken)  pm.collectionVariables.set('accessToken',  body.accessToken);",
                  "    if (body.refreshToken) pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "    console.log('[Auth] accessToken and refreshToken saved.');",
                  "    pm.test('Logged in after registration', function() {",
                  "        pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationToken\": \"{{registrationToken}}\",\n  \"password\": \"P@ssw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/complete-registration",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "complete-registration"
              ]
            },
            "description": "Screen 3/3: sets the account password (auto-encrypted). Username is auto-derived from phone digits. Returns JWT + refresh token (auto-login). Saves tokens to collection variables."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var body = pm.response.json();",
                  "    if (body.accessToken)  pm.collectionVariables.set('accessToken',  body.accessToken);",
                  "    if (body.refreshToken) pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "    console.log('[Auth] accessToken and refreshToken saved.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrPhone\": \"+201234567890\",\n  \"password\": \"P@ssw0rd123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticates with username or phone. The `password` field is encrypted automatically. Saves tokens to collection variables on success. If the account is unverified, the server will resend the registration OTP and return a localized message about the OTP being sent."
          },
          "response": []
        },
